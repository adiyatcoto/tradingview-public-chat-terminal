# Copy this file to ".env". Never upload or commit the resulting ".env" file.
#
# RECOMMENDED METHOD — Manual browser session (Bypasses CAPTCHA & 2FA)
# Obtain these cookie values from your browser's Developer Tools (F12) -> Application/Storage -> Cookies
TV_SESSIONID=
TV_SESSIONID_SIGN=
TV_DEVICE_T=
# Your public TradingView handle/username (for mention and reply matching)
TV_CHAT_USERNAME=

# ALTERNATIVE METHOD — Username and password (Automatic sign-in)
# The server uses these values to sign in when no valid saved session exists.
# Note: This can fail if TradingView requests CAPTCHA or two-factor authentication.
# TV_USERNAME=
# TV_PASSWORD=
