# Copy this file to ".env". Never upload or commit the resulting ".env" file.
#
# CHOOSE ONE AUTHENTICATION METHOD:
#
# METHOD 1 — Username and password
# The server uses these values to sign in when no valid saved session exists.
# This can fail when TradingView requires CAPTCHA or two-factor authentication.
TV_USERNAME=
TV_PASSWORD=
# Optional: set this when TV_USERNAME is an email address so mention and reply
# matching uses the correct public TradingView handle.
TV_CHAT_USERNAME=

# METHOD 2 — Manual browser session (fallback when method 1 is unavailable)
# Obtain these values only from your own authenticated tradingview.com browser
# session. When complete, this method takes precedence over username/password.
TV_SESSIONID=
TV_SESSIONID_SIGN=
TV_DEVICE_T=
